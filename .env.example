# ============================================================================
# MS MANAGEMENT CONSULTING BILLING SYSTEM — ENVIRONMENT TEMPLATE
# ============================================================================
# Instructions:
# 1. Copy this template to '.env' for local development:
#    cp .env.example .env
# 2. In production (Vercel), add these keys in:
#    Project Settings -> Environment Variables
# 3. NEVER commit your actual '.env' file or service-role keys to source control.
# ============================================================================

# --- 1. Client-Facing Public Configuration (Bundled by Vite) ---
# Retrieve from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# --- 2. Server-Side Administrative Configuration (Serverless / API Only) ---
# WARNING: NEVER prefix SUPABASE_SERVICE_ROLE_KEY with VITE_ or expose to the frontend.
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- 3. Optional Setup & Hardening Secrets ---
# High-entropy secret string used only if provisioning the first admin via HTTP endpoint.
# Alternatively, use the operator CLI: npm run bootstrap:admin
BOOTSTRAP_SECRET=your_random_32_character_bootstrap_secret_here
